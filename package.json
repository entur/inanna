{
  "name": "inanna",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "run-p --race copy:theme copy:config",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "copy:theme": "ncp .github/environments/theme-dev.json public/theme-dev.json",
    "copy:config": "ncp .github/environments/config-dev.json public/config.json",
    "lint": "eslint .",
    "check": "prettier . --check",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@mui/x-data-grid": "^8.2.0",
    "i18next": "^25.10.9",
    "i18next-browser-languagedetector": "^8.2.2",
    "maplibre-gl": "^6.15.0",
    "npm-run-all": "^4.1.5",
    "oidc-client-ts": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-map-gl": "^8.0.4",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.12",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "ncp": "^2.0.0",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
